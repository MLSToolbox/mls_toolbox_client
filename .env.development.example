# Configuración para ambiente DEVELOPMENT (desarrollo en servidor gessi.cs.upc.edu)
# Copiar este archivo a .env.development y ajustar según necesidades

ENVIRONMENT=development

# Frontend Configuration
PORT=80
EXTERNAL_PORT=4201
IMAGE_TAG=mls_toolbox_client:development
CONTAINER_NAME=mls_toolbox_client_dev

# Backend API URL para desarrollo en servidor remoto
# IMPORTANTE: El frontend se ejecuta en el NAVEGADOR del usuario,
# por lo que debe usar la URL pública del servidor, NO localhost
# (localhost funcionará solo si el usuario tiene Docker local corriendo)
API_URL=https://gessi.cs.upc.edu:1448/api
API_TIMEOUT=30000

# Docker Network
DOCKER_NETWORK=mls-network
