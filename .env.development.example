# Configuración para ambiente DEVELOPMENT (desarrollo en servidor gessi.cs.upc.edu)
# Copiar este archivo a .env.development y ajustar según necesidades

ENVIRONMENT=development

# Frontend Configuration
PORT=80
EXTERNAL_PORT=4201
IMAGE_TAG=mls_toolbox_client:development
CONTAINER_NAME=mls_toolbox_client

# Backend API URL para desarrollo en servidor remoto
# El navegador hace las peticiones desde la máquina del usuario,
# por lo que debe usar la URL pública o localhost si es local
# En servidor: usar gessi.cs.upc.edu con el puerto expuesto (5001)
API_URL=http://localhost:5001/api
API_TIMEOUT=30000

# Docker Network
DOCKER_NETWORK=mls-network
