# Configuración para ambiente PRODUCTION (producción en servidor gessi.cs.upc.edu)
# Copiar este archivo a .env.production y ajustar según necesidades

ENVIRONMENT=production

# Frontend Configuration
PORT=80
EXTERNAL_PORT=4200
IMAGE_TAG=mls_toolbox_client:production
CONTAINER_NAME=mls_toolbox_client

# Backend API URL para producción
# El navegador hace las peticiones desde la máquina del usuario,
# por lo que debe usar localhost y el puerto expuesto del host
API_URL=http://localhost:5000/api
API_TIMEOUT=30000

# Docker Network
DOCKER_NETWORK=mls-network
