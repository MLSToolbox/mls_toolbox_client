# Configuración para ambiente LOCAL (desarrollo local)
# Copiar este archivo a .env.local y ajustar según necesidades

ENVIRONMENT=local

# Frontend Configuration
PORT=4200
IMAGE_TAG=mls_toolbox_client:local
CONTAINER_NAME=mls_toolbox_client

# Backend API URL (donde el frontend hará peticiones)
# El navegador hace las peticiones, no el contenedor nginx,
# por lo que debe usar localhost y el puerto expuesto del host
API_URL=http://localhost:5000/api
API_TIMEOUT=30000

# Docker Network
DOCKER_NETWORK=mls-network
